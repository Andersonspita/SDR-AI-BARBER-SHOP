# Produção na VPS. Copie para .env na pasta do projeto e preencha.
# Gere cada segredo com: openssl rand -base64 48 | tr -d '/+=' | cut -c1-48

# Endereço público do SDR (painel + API no mesmo domínio, atrás do proxy com HTTPS)
PUBLIC_URL=https://sdr.horizonaj.com.br
# Porta local (só 127.0.0.1) do gateway do SDR, para onde o proxy da VPS encaminha.
# 8000/3000/8080 já estão ocupadas na VPS.
SDR_HTTP_PORT=8110

# Banco (só na rede interna do compose)
POSTGRES_USER=sdr_admin
POSTGRES_PASSWORD=
POSTGRES_DB=gerente_barber_sdr

# Acesso ao painel (admin único). Senha com 12+ caracteres.
ADMIN_EMAIL=
ADMIN_PASSWORD=
JWT_SECRET=
SESSION_TTL_HOURS=12

# WhatsApp: deixe MOCK até conectar o número na Evolution (aí troque para EVOLUTION).
WHATSAPP_PROVIDER=MOCK
EVOLUTION_INSTANCE=gerente-barber-sdr
EVOLUTION_API_KEY=
WEBHOOK_SECRET=

# Integração com o barber-shop (mesma VPS, pelo domínio público)
SAAS_BASE_URL=https://barber-shop.horizonaj.com.br
BARBERSHOP_API_URL=https://barber-shop.horizonaj.com.br
# = PROVISIONING_API_KEY do .env do barber-shop
BARBERSHOP_PROVISIONING_KEY=
# = SDR_WEBHOOK_SECRET do .env do barber-shop
BARBERSHOP_WEBHOOK_SECRET=
TRIAL_MODE=STAND_BY
TRIAL_DAYS=7
BARBERSHOP_ALLOW_SYNTHETIC_TRIALS=false

# Busca real de barbearias (Places API). Vazio = leads fictícios (bloqueados para envio real).
GOOGLE_MAPS_API_KEY=
# Sem chave do Google: Google Maps pelo Apify (token em apify.com -> Settings -> API & Integrations).
APIFY_TOKEN=
APIFY_MAX_PLACES=20

# Cadência e anti-ban
ANTIBAN_DAILY_LIMIT_PER_INSTANCE=50
CADENCE_WORKER_ENABLED=true
