# Copie para .env e ajuste. O docker-compose lê este arquivo e depois o .env (que sobrescreve).

# Banco de Dados & Fila
# Sem DATABASE_URL (ou com Postgres fora do ar) a API usa memória e os dados somem ao reiniciar.
# STORAGE_BACKEND: auto (Postgres com fallback p/ memória) | postgres (falha se não conectar) | memory
DATABASE_URL=postgresql+asyncpg://sdr_admin:sdr_secret_2026@localhost:5432/gerente_barber_sdr
STORAGE_BACKEND=auto
DATABASE_CONNECT_ATTEMPTS=3
REDIS_URL=redis://localhost:6379/0

# SaaS Principal (Gerente Barber)
# Mesmo valor do APP_URL do barber-shop (vitrines em /{slug}).
SAAS_BASE_URL=https://barber-shop.horizonaj.com.br
# STAND_BY = humano libera o teste pelo painel | AUTO_LINK = libera na conversa assim que o dono manda o e-mail
TRIAL_MODE=STAND_BY

# Integração com o barber-shop (teste grátis). Vazio = integração desligada.
# URL da API do barber-shop (no deploy com nginx, a mesma do site).
BARBERSHOP_API_URL=
# Igual ao PROVISIONING_API_KEY do barber-shop (só cria testes; não é a chave da plataforma).
BARBERSHOP_PROVISIONING_KEY=
# Igual ao SDR_WEBHOOK_SECRET do barber-shop. Mínimo de 32 caracteres com WhatsApp real.
BARBERSHOP_WEBHOOK_SECRET=
TRIAL_DAYS=7
# true só em teste local: libera teste grátis para leads fictícios (cria barbearias de verdade!)
BARBERSHOP_ALLOW_SYNTHETIC_TRIALS=false

# Painel (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000
FRONTEND_ORIGINS=http://localhost:3000

# Acesso ao painel/API (admin único). Com WHATSAPP_PROVIDER real a API NÃO sobe se:
#  - ADMIN_PASSWORD for este valor padrão ou tiver menos de 12 caracteres
#  - JWT_SECRET ou WEBHOOK_SECRET estiverem vazios/padrão ou com menos de 32 caracteres
#  - COOKIE_SECURE não for true (painel precisa estar em HTTPS)
# Gere segredos com: python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_EMAIL=admin@gerentebarber.local
ADMIN_PASSWORD=troque-esta-senha
# Vazio = segredo aleatório por processo (sessões caem a cada restart; só para dev)
JWT_SECRET=
SESSION_TTL_HOURS=12
COOKIE_SECURE=false

# Evolution API / Z-API (WhatsApp)
# MOCK = nada sai da máquina. EVOLUTION = envio real (leads fictícios continuam bloqueados).
WHATSAPP_PROVIDER=MOCK
EVOLUTION_BASE_URL=http://localhost:8080
EVOLUTION_INSTANCE=gerente-barber-sdr
EVOLUTION_API_KEY=gerente-barber-evo-key
# Segredo do webhook: a Evolution chama /webhook/whatsapp?token=<WEBHOOK_SECRET>
WEBHOOK_SECRET=troque-este-segredo-do-webhook

# Anti-Ban Cadence Engine
ANTIBAN_MIN_DELAY_SEC=45
ANTIBAN_MAX_DELAY_SEC=180
ANTIBAN_DAILY_LIMIT_PER_INSTANCE=50

# Worker da régua D0 -> D2 (2 dias) -> D5 (3 dias depois). Horários em Brasília.
CADENCE_WORKER_ENABLED=true
CADENCE_SEND_HOURS=8-20
# 0 = segunda ... 6 = domingo
CADENCE_SEND_WEEKDAYS=0-5
CADENCE_POLL_INTERVAL_SEC=30

# Busca real de barbearias (Places API New). Sem a chave, o scraper gera leads FICTÍCIOS,
# marcados como SYNTHETIC e bloqueados para envio real de WhatsApp.
GOOGLE_MAPS_API_KEY=
# Quem assina a primeira mensagem: "Aqui é o <nome>, do Gerente Barber." Vazio = "Aqui é do Gerente Barber."
SDR_SENDER_NAME=
# Alternativa sem Google Cloud: Google Maps pelo Apify (conta grátis, sem cartão, US$ 5/mês de crédito).
# Usado quando GOOGLE_MAPS_API_KEY está vazio. Token em apify.com -> Settings -> API & Integrations.
APIFY_TOKEN=
# Barbearias por busca no Apify (também é o teto de cobrança de cada busca).
APIFY_MAX_PLACES=20

# Opcional: LLM (ainda não usado; respostas vêm de templates)
OPENAI_API_KEY=
GEMINI_API_KEY=
